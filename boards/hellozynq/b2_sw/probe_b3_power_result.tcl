if {$argc != 0} {
    error "usage: probe_b3_power_result.tcl"
}

proc emit {name address} {
    puts "$name=[mrd -value $address]"
}

connect -url tcp:localhost:3121
puts "B3_POWER_RESULT_TARGETS_BEGIN"
puts [targets]
puts "B3_POWER_RESULT_TARGETS_END"
targets -set -nocase -filter {name =~ "*Cortex-A9*#0*"}
emit B3_POWER_RESULT_MAGIC 0x01008600
emit B3_POWER_RESULT_SCHEMA_VERSION 0x01008604
emit B3_POWER_RESULT_STATUS 0x01008608
emit B3_POWER_RESULT_MODE 0x0100860C
emit B3_POWER_WARMUP_REQUESTED 0x01008610
emit B3_POWER_WARMUP_COMPLETED 0x01008614
emit B3_POWER_WINDOW_SECONDS 0x01008618
emit B3_POWER_START_DELAY_SECONDS 0x0100861C
emit B3_POWER_MINIMUM_VALID_INFERENCES 0x01008620
emit B3_POWER_VALID_INFERENCES 0x01008624
emit B3_POWER_FAILED_INFERENCES 0x01008628
emit B3_POWER_PROTOCOL_ERROR_COUNT 0x0100862C
emit B3_POWER_ELAPSED_SECONDS 0x01008630
emit B3_POWER_LAST_COMPUTE_CYCLES 0x01008634
emit B3_POWER_EXECUTE_GROUP_COUNT 0x01008638
emit B3_POWER_SKIP_GROUP_COUNT 0x0100863C
emit B3_POWER_LAST_SEQUENCE 0x01008640
emit B3_POWER_ERROR_CODE 0x01008644
disconnect
exit 0
