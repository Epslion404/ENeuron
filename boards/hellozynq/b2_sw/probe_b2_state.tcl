connect -url tcp:localhost:3121
targets -set -nocase -filter {name =~ "*Cortex-A9*#0*"}
catch {stop}
puts "B2_CPU_STATE=[state]"
puts "B2_CPU_PC=[rrd pc]"
puts "B2_CPU_SP=[rrd sp]"
puts "B2_CPU_CPSR=[rrd cpsr]"
puts "B2_UART_CR=[mrd -force -value 0xE0000000]"
puts "B2_UART_MR=[mrd -force -value 0xE0000004]"
puts "B2_UART_BAUDGEN=[mrd -force -value 0xE0000018]"
puts "B2_UART_SR=[mrd -force -value 0xE000002C]"
puts "B2_UART_BAUDDIV=[mrd -force -value 0xE0000034]"
puts "B2_STATUS_MAGIC=[mrd -value 0x01008000]"
puts "B2_STATUS_STATUS=[mrd -value 0x01008004]"
puts "B2_STATUS_SEQUENCE=[mrd -value 0x01008008]"
puts "B2_STATUS_LENGTH=[mrd -value 0x0100800C]"
puts "B2_STATUS_TX_ADDR=[mrd -value 0x01008010]"
puts "B2_STATUS_RX_ADDR=[mrd -value 0x01008014]"
puts "B2_STATUS_FLUSH=[mrd -value 0x01008018]"
puts "B2_STATUS_INVALIDATE=[mrd -value 0x0100801C]"
puts "B2_STATUS_TX_CR=[mrd -value 0x01008020]"
puts "B2_STATUS_TX_SR=[mrd -value 0x01008024]"
puts "B2_STATUS_TX_BTT=[mrd -value 0x01008028]"
puts "B2_STATUS_RX_CR=[mrd -value 0x0100802C]"
puts "B2_STATUS_RX_SR=[mrd -value 0x01008030]"
puts "B2_STATUS_RX_BTT=[mrd -value 0x01008034]"
puts "B2_STATUS_CRC=[mrd -value 0x01008038]"
puts "B2_STATUS_FRAMES_TOTAL=[mrd -value 0x0100803C]"
puts "B2_STATUS_FRAMES_PASSED=[mrd -value 0x01008040]"
puts "B2_STATUS_FRAMES_REJECTED=[mrd -value 0x01008044]"
puts "B2_STATUS_FRAMES_FAILED=[mrd -value 0x01008048]"
puts "B2_STATUS_PRESSURE_STATUS=[mrd -value 0x0100804C]"
puts "B2_STATUS_PRESSURE_TOTAL=[mrd -value 0x01008050]"
puts "B2_STATUS_PRESSURE_PASSED=[mrd -value 0x01008054]"
puts "B2_STATUS_PRESSURE_FAILED=[mrd -value 0x01008058]"
puts "B2_STATUS_PRESSURE_CRC=[mrd -value 0x0100805C]"
puts "B2_STATUS_PRESSURE_LAST_SEQUENCE=[mrd -value 0x01008060]"
puts "B2_STATUS_BACKPRESSURE_STATUS=[mrd -value 0x01008064]"
puts "B2_STATUS_BACKPRESSURE_TOTAL=[mrd -value 0x01008068]"
puts "B2_STATUS_BACKPRESSURE_PASSED=[mrd -value 0x0100806C]"
puts "B2_STATUS_BACKPRESSURE_FAILED=[mrd -value 0x01008070]"
puts "B2_STATUS_BACKPRESSURE_CRC=[mrd -value 0x01008074]"
puts "B2_STATUS_BACKPRESSURE_LAST_SEQUENCE=[mrd -value 0x01008078]"
puts "B2_STATUS_BACKPRESSURE_STALL_CYCLES=[mrd -value 0x0100807C]"
puts "B2_STATUS_WRAP_STATUS=[mrd -value 0x01008280]"
puts "B2_STATUS_WRAP_TOTAL=[mrd -value 0x01008284]"
puts "B2_STATUS_WRAP_PASSED=[mrd -value 0x01008288]"
puts "B2_STATUS_WRAP_FAILED=[mrd -value 0x0100828C]"
puts "B2_STATUS_WRAP_CRC=[mrd -value 0x01008290]"
puts "B2_STATUS_WRAP_LAST_SEQUENCE=[mrd -value 0x01008294]"
puts "B2_STATUS_WRAP_SLOT_MASK_LO=[mrd -value 0x01008298]"
puts "B2_STATUS_WRAP_SLOT_MASK_HI=[mrd -value 0x0100829C]"
puts "B2_STATUS_WRAP_ROLLOVERS=[mrd -value 0x010082A0]"
puts "B2_STATUS_WRAP_FIRST_TX_ADDR=[mrd -value 0x010082A4]"
puts "B2_STATUS_WRAP_FIRST_RX_ADDR=[mrd -value 0x010082A8]"
puts "B2_STATUS_WRAP_LAST_TX_ADDR=[mrd -value 0x010082AC]"
puts "B2_STATUS_WRAP_LAST_RX_ADDR=[mrd -value 0x010082B0]"
puts "B2_STATUS_RECOVERY_STATUS=[mrd -value 0x01008300]"
puts "B2_STATUS_RECOVERY_TIMEOUT=[mrd -value 0x01008304]"
puts "B2_STATUS_RECOVERY_RESET=[mrd -value 0x01008308]"
puts "B2_STATUS_RECOVERY_PASSED=[mrd -value 0x0100830C]"
puts "B2_STATUS_RECOVERY_FAILED=[mrd -value 0x01008310]"
puts "B2_STATUS_RECOVERY_SEQUENCE=[mrd -value 0x01008314]"
puts "B2_STATUS_RECOVERY_CRC=[mrd -value 0x01008318]"
puts "B2_STATUS_RECOVERY_READY_BEFORE=[mrd -value 0x0100831C]"
puts "B2_STATUS_RECOVERY_READY_STOPPED=[mrd -value 0x01008320]"
puts "B2_STATUS_RECOVERY_READY_AFTER_RESET=[mrd -value 0x01008324]"
puts "B2_STATUS_GAP_STATUS=[mrd -value 0x01008340]"
puts "B2_STATUS_GAP_TOTAL=[mrd -value 0x01008344]"
puts "B2_STATUS_GAP_PASSED=[mrd -value 0x01008348]"
puts "B2_STATUS_GAP_FAILED=[mrd -value 0x0100834C]"
puts "B2_STATUS_GAP_REQUESTED_US=[mrd -value 0x01008350]"
puts "B2_STATUS_GAP_FIRST_SEQUENCE=[mrd -value 0x01008354]"
puts "B2_STATUS_GAP_SECOND_SEQUENCE=[mrd -value 0x01008358]"
puts "B2_STATUS_GAP_FIRST_LENGTH=[mrd -value 0x0100835C]"
puts "B2_STATUS_GAP_SECOND_LENGTH=[mrd -value 0x01008360]"
puts "B2_STATUS_GAP_FIRST_CRC=[mrd -value 0x01008364]"
puts "B2_STATUS_GAP_SECOND_CRC=[mrd -value 0x01008368]"
puts "B2_STATUS_GAP_CRC_XOR=[mrd -value 0x0100836C]"
puts "B2_STATUS_ERROR_STATUS=[mrd -value 0x01008380]"
puts "B2_STATUS_ERROR_MODE=[mrd -value 0x01008384]"
puts "B2_STATUS_ERROR_OBSERVED=[mrd -value 0x01008388]"
puts "B2_STATUS_ERROR_TIMEOUT=[mrd -value 0x0100838C]"
puts "B2_STATUS_ERROR_DMA_ERROR=[mrd -value 0x01008390]"
puts "B2_STATUS_ERROR_RESET=[mrd -value 0x01008394]"
puts "B2_STATUS_ERROR_RECOVERY=[mrd -value 0x01008398]"
puts "B2_STATUS_ERROR_FAILED=[mrd -value 0x0100839C]"
puts "B2_STATUS_ERROR_SEQUENCE=[mrd -value 0x010083A0]"
puts "B2_STATUS_ERROR_RECOVERY_SEQUENCE=[mrd -value 0x010083A4]"
puts "B2_STATUS_ERROR_MM2S_TLAST=[mrd -value 0x010083A8]"
puts "B2_STATUS_ERROR_S2MM_TLAST=[mrd -value 0x010083AC]"
puts "B2_STATUS_ERROR_MM2S_BEATS=[mrd -value 0x010083B0]"
puts "B2_STATUS_ERROR_S2MM_BEATS=[mrd -value 0x010083B4]"
puts "B2_TX_WORDS_BEGIN"
for {set index 0} {$index < 16} {incr index} {
    set address [expr {0x01006000 + ($index * 4)}]
    puts [format "B2_TX_WORD_%02d=0x%08X" $index [mrd -value $address]]
}
puts "B2_TX_WORDS_END"
puts "B2_RX_WORDS_BEGIN"
for {set index 0} {$index < 16} {incr index} {
    set address [expr {0x01007000 + ($index * 4)}]
    puts [format "B2_RX_WORD_%02d=0x%08X" $index [mrd -value $address]]
}
puts "B2_RX_WORDS_END"
puts "B2_LEDGER_BEGIN"
for {set index 0} {$index < 8} {incr index} {
    # frame_ledger 是 16 个 u32，必须按 64 bytes 读取，避免记录之间重叠。
    set base [expr {0x01008080 + ($index * 64)}]
    puts "B2_LEDGER_[format %02d $index]_SEQ=[mrd -force -value $base]"
    puts "B2_LEDGER_[format %02d $index]_LEN=[mrd -force -value [expr {$base + 4}]]"
    puts "B2_LEDGER_[format %02d $index]_STATUS=[mrd -force -value [expr {$base + 8}]]"
    puts "B2_LEDGER_[format %02d $index]_CRC=[mrd -force -value [expr {$base + 12}]]"
    puts "B2_LEDGER_[format %02d $index]_ELAPSED=[mrd -force -value [expr {$base + 16}]]"
    puts "B2_LEDGER_[format %02d $index]_INVALIDATE=[mrd -force -value [expr {$base + 20}]]"
    puts "B2_LEDGER_[format %02d $index]_MM2S_BEATS=[mrd -force -value [expr {$base + 24}]]"
    puts "B2_LEDGER_[format %02d $index]_S2MM_BEATS=[mrd -force -value [expr {$base + 28}]]"
    puts "B2_LEDGER_[format %02d $index]_MM2S_TLAST_LO=[mrd -force -value [expr {$base + 32}]]"
    puts "B2_LEDGER_[format %02d $index]_MM2S_TLAST_HI=[mrd -force -value [expr {$base + 36}]]"
    puts "B2_LEDGER_[format %02d $index]_S2MM_TLAST_LO=[mrd -force -value [expr {$base + 40}]]"
    puts "B2_LEDGER_[format %02d $index]_S2MM_TLAST_HI=[mrd -force -value [expr {$base + 44}]]"
    puts "B2_LEDGER_[format %02d $index]_MM2S_BYTES_LO=[mrd -force -value [expr {$base + 48}]]"
    puts "B2_LEDGER_[format %02d $index]_MM2S_BYTES_HI=[mrd -force -value [expr {$base + 52}]]"
    puts "B2_LEDGER_[format %02d $index]_S2MM_BYTES_LO=[mrd -force -value [expr {$base + 56}]]"
    puts "B2_LEDGER_[format %02d $index]_S2MM_BYTES_HI=[mrd -force -value [expr {$base + 60}]]"
}
puts "B2_LEDGER_END"
if {[catch {
    puts "B2_DMA_TX_CR=[mrd -force -value 0x40400000]"
    puts "B2_DMA_TX_SR=[mrd -force -value 0x40400004]"
    puts "B2_DMA_TX_ADDR=[mrd -force -value 0x40400018]"
    puts "B2_DMA_TX_BTT=[mrd -force -value 0x40400028]"
    puts "B2_DMA_RX_CR=[mrd -force -value 0x40400030]"
    puts "B2_DMA_RX_SR=[mrd -force -value 0x40400034]"
    puts "B2_DMA_RX_ADDR=[mrd -force -value 0x40400048]"
    puts "B2_DMA_RX_BTT=[mrd -force -value 0x40400058]"
} dma_error]} {
    puts "B2_DMA_PL_READ=UNAVAILABLE"
}

proc emit_probe_state {label base} {
    puts "${label}_BASE=[format 0x%08X $base]"
    puts "${label}_CONFIG=[mrd -force -value [expr {$base + 0x04}]]"
    puts "${label}_SAMPLE=[mrd -force -value [expr {$base + 0x20}]]"
    puts "${label}_BEATS=[mrd -force -value [expr {$base + 0x50}]]"
    puts "${label}_TLAST=[mrd -force -value [expr {$base + 0x80}]]"
    puts "${label}_BYTES=[mrd -force -value [expr {$base + 0x88}]]"
    puts "${label}_CYCLES=[mrd -force -value [expr {$base + 0x90}]]"
    puts "${label}_STALL=[mrd -force -value [expr {$base + 0x98}]]"
    puts "${label}_STARVE=[mrd -force -value [expr {$base + 0xA0}]]"
    puts "${label}_LAST_TKEEP=[mrd -force -value [expr {$base + 0xA8}]]"
}
if {[catch {
    emit_probe_state B2_PROBE_MM2S 0x40410000
    emit_probe_state B2_PROBE_S2MM 0x40420000
} probe_error]} {
    puts "B2_PROBE_READ=UNAVAILABLE"
    puts "B2_PROBE_ERROR=$probe_error"
}
set npu_status_base 0x40430000
puts "B2_NPU_STATUS_BASE=[format 0x%08X $npu_status_base]"
puts "B2_NPU_STATUS=[mrd -force -value [expr {$npu_status_base + 0x00}]]"
puts "B2_NPU_COMMAND_ACCEPT=[mrd -force -value [expr {$npu_status_base + 0x04}]]"
puts "B2_NPU_COMMAND_COMPLETE=[mrd -force -value [expr {$npu_status_base + 0x08}]]"
puts "B2_NPU_SAMPLE_ACCEPT=[mrd -force -value [expr {$npu_status_base + 0x0C}]]"
puts "B2_NPU_SAMPLE_COMPLETE=[mrd -force -value [expr {$npu_status_base + 0x10}]]"
puts "B2_NPU_RESPONSE_ACCEPT=[mrd -force -value [expr {$npu_status_base + 0x14}]]"
puts "B2_NPU_RESPONSE_COMPLETE=[mrd -force -value [expr {$npu_status_base + 0x18}]]"
puts "B2_NPU_RESULT_ACCEPT=[mrd -force -value [expr {$npu_status_base + 0x1C}]]"
puts "B2_NPU_RESULT_COMPLETE=[mrd -force -value [expr {$npu_status_base + 0x20}]]"
puts "B2_NPU_EXECUTE_GROUP_COUNT=[mrd -force -value [expr {$npu_status_base + 0x48}]]"
puts "B2_NPU_SKIP_GROUP_COUNT=[mrd -force -value [expr {$npu_status_base + 0x4C}]]"
puts "B2_NPU_RUNTIME_STATUS=[mrd -force -value [expr {$npu_status_base + 0x50}]]"
puts "B2_NPU_ACTIVE_MASK_EPOCH=[mrd -force -value [expr {$npu_status_base + 0x54}]]"
puts "B2_NPU_PENDING_MASK_EPOCH=[mrd -force -value [expr {$npu_status_base + 0x58}]]"
puts "B2_NPU_LAST_COMPUTE_CYCLES=[mrd -force -value [expr {$npu_status_base + 0x5C}]]"
puts "B2_NPU_PROTOCOL_ERROR_COUNT=[mrd -force -value [expr {$npu_status_base + 0x60}]]"
puts "B2_NPU_FENCE_SNAPSHOT_VALID=[mrd -force -value [expr {$npu_status_base + 0x24}]]"
for {set index 0} {$index < 8} {incr index} {
    set address [expr {$npu_status_base + 0x28 + ($index * 4)}]
    puts [format "B2_NPU_FENCE_SNAPSHOT_%02d=0x%08X" $index [mrd -force -value $address]]
}
con
disconnect
