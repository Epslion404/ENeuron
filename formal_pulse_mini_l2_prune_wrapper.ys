# Pulse-Mini-L2 wrapper：FEEDBACK exactly-once、utility 顺序与背压不变量。
read_verilog -formal -sv local_prune_gate_2of4.sv local_prune_evidence_gain.sv pulse_mini_l2_core.sv pulse_mini_prune_bridge.sv pulse_mini_l2_prune_wrapper.sv formal_pulse_mini_l2_prune_wrapper.sv
prep -top formal_pulse_mini_l2_prune_wrapper -flatten
async2sync
memory_map
opt_clean
sat -seq 32 -set-assumes -set-init-zero -prove-asserts -verify -dump_vcd formal_pulse_mini_l2_prune_wrapper_cex.vcd
