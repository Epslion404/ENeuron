{
  "schema": "npu_single_clock_contract_provisional_v2",
  "status": "approved_by_admin",
  "source": "docs/planning/NPU_SINGLE_CLOCK_RTL_DECISION_SHEET_V2.md",
  "scope": {
    "clock_domains": 1,
    "model_shape": [64, 32, 10],
    "group_size": 4,
    "rtl_allowed": true,
    "vivado_allowed": false
  },
  "sample_stream": {
    "beat_count": 8,
    "beat_width_bits": 32,
    "pixels_per_beat": 8,
    "packing": "pixel[8*k+j]=beat_data[4*j+:4]",
    "beat_index": "internal_counter",
    "external_last": false,
    "sample_id_bits": 32,
    "payload_hold_on_backpressure": true
  },
  "result_stream": {
    "beat_count": 10,
    "beat_width_bits": 32,
    "encoding": "signed_int32",
    "beat_index": "internal_counter",
    "external_last": false,
    "metadata": ["sample_id_32", "mask_epoch_32"],
    "model_epoch": false,
    "payload_hold_on_backpressure": true
  },
  "config_stream": {
    "command_width_bits": 128,
    "response_width_bits": 128,
    "single_external_stream": true,
    "model_word_count": 634,
    "mask_word_count": 19,
    "invalid_request_handshake": true,
    "error_response_single_slot": true
  },
  "arbitration": {
    "priority": ["reset", "response_consume", "result_publish", "config_command_accept", "sample_accept"],
    "commit_collision": "single_command_stream_serializes_model_and_mask",
    "config_beats_sample": true,
    "sample_locks_epoch_on_first_beat": true
  },
  "validity": {
    "mask_after_reset": "all_open",
    "mask_valid_after_reset": false,
    "mask_valid_meaning": "user_published_mask_exists",
    "sample_ready_when_model_invalid": false,
    "runtime_idle_requires_empty_result_and_error_slots": true
  },
  "review_gates": {
    "approve_before_rtl": true,
    "python_rtl_bit_exact_seed_count": 20,
    "samples_per_seed": 100,
    "minimum_samples": 2000,
    "vivado_after_icarus": true
  }
}
